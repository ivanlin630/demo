#!/bin/sh
# ★ verification-gate pre-commit hook（fail-closed 運輸層，sibling of 手動 constitution_gate）。
# rule：sim-measured slice（verdicts/<slice>.measure.json is_sim:true）缺 QA PASS → 擋 commit。
#
# 安裝（★systems 協調啟用時序：QA/measurer 採 .qa.json schema 通知後才裝，見 spec 部署裁定 #2）：
#   cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# 繞過 `git commit --no-verify` 須系統認可（同 constitution_gate 規矩）。
#
# ★fast-exit：只在本 branch slice 有 .measure.json 時才啟 godot（一般 commit 零 godot 開銷）。

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
slice=$(printf '%s' "$branch" | sed 's|^feat/||')
measure="docs/process/verdicts/${slice}.measure.json"

# 本 branch slice 無 measure verdict → 無 sim 量測要 gate → 放行（不啟 godot）。
[ -f "$measure" ] || exit 0

# 找 godot exe（wrapper 同法：repo tools 優先）。
GODOT="tools/godot/Godot_v4.2.2-stable_win64_console.exe"
[ -x "$GODOT" ] || GODOT="A:/GDS/demo/tools/godot/Godot_v4.2.2-stable_win64_console.exe"
if [ ! -x "$GODOT" ]; then
	echo "[pre-commit] verification-gate skip（godot exe 未找到 $GODOT）"
	exit 0
fi

# branch-scoped 跑 verification_gate（免 stale 誤擋）。
"$GODOT" --headless --script scripts/debug/verification_gate.gd -- --slice="$slice" 2>/dev/null | grep -q "\[VERIFICATION-GATE\] PASS"
if [ $? -ne 0 ]; then
	echo "[pre-commit] ★VERIFICATION-GATE FAIL：slice '$slice' 有 sim 量測(is_sim:true)但缺 QA PASS verdict。"
	echo "[pre-commit]   修 docs/process/verdicts/${slice}.qa.json（verdict:PASS）後再 commit，或 --no-verify（系統認可）。"
	echo "[pre-commit]   詳跑：./tools/godot.ps1 --headless --script scripts/debug/verification_gate.gd -- --slice=$slice"
	exit 1
fi
exit 0
