# Godot 4+ specific ignores
.godot/

# Local tools (executables, not source)
tools/*
!tools/orchestrator/
# ★telegram bridge：程式碼納版控（同 .claude 的理由：改版要能 revert）；
#   config.local.sh 含真 TG_TOKEN ⇒ 續 ignore，執行期產物(.tg_poll.lock/.tg_last_id)也 ignore。
!tools/telegram/
tools/telegram/*
!tools/telegram/*.py
!tools/telegram/*.sh
!tools/telegram/README.md
tools/telegram/config.local.sh

# Claude Code local config
# .claude：★harness 納入版控（2026-08-21）——改版前提「每步可獨立 revert」需要版控，
#   而原本整包 ignore = 0 追蹤檔 = 沒有 revert 安全網、fresh clone 也拿不到 harness。
#   只納 hooks/*.sh 與 settings.json；locks/.busy.*/settings.local.json(機器專屬)/worktrees(整包 repo 拷貝) 續 ignore。
.claude/*
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/*.sh
# ★閘的列舉器（computed_prop_sites.py）――它要認型別，shell 做不來。
#   ★★gitignore 【不支援行內註解】：註解写在 pattern 後面會變成 pattern 的一部分，
#   而它不會報錯――只是這條規則從此什麼都不匹配。
!.claude/hooks/*.py
!.claude/settings.json

# Superpowers plugin cache
.superpowers/

# Git worktrees (child session workspaces)
.worktrees/

# Debug/test output files
*_out.txt
*_output.txt
test_*.gd

# Godot run logs (run artifacts)
*.log

# Root-level playtest screenshots（遊戲素材在 res:// 子目錄,不受影響）
/*.png
/*.PNG
/*.png.import
/*.PNG.import
*.stackdump

# S1b 裸 tick 守衛的暫存產物（每次重跑重生，不進 repo）
docs/measurements/.bare-tick-gate-*.txt

# ★別 session 的暫存檔（2026-08-27 血證：systems 的 git add -A 把它掃進 repo）
/scratchpad_*.txt
/scratchpad_*.py

# hook 事實檔／beacon（session-local，不進 repo）
.claude/hooks/.busy.*
.claude/hooks/.committed.*
.claude/hooks/.godot-runs.log
