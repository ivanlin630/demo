diff --git a/scripts/simulation/resource_bank.gd b/scripts/simulation/resource_bank.gd
index db5e56832..51e95970a 100644
--- a/scripts/simulation/resource_bank.gd
+++ b/scripts/simulation/resource_bank.gd
@@ -30,6 +30,32 @@ static func _tap_coin(res: String, delta: float, reason: String) -> void:
 	Probe.add_amount("coin.flow.by." + reason, absf(delta))
 	Probe.bump("coin.flow.n")
 
+# ★MX 量測專用（game2-accounts worktree，不進 main）：純觀測、零 RNG。env GDS_MX_LOG 未設 => 不寫
+static var _mx_tick: int = 0
+static var _mx_ptid: int = -1
+static func mx(line: String) -> void:
+	var p: String = OS.get_environment("GDS_MX_LOG")
+	if p == "":
+		return
+	var f := FileAccess.open(p, FileAccess.READ_WRITE if FileAccess.file_exists(p) else FileAccess.WRITE)
+	if f == null:
+		return
+	f.seek_end()
+	f.store_line("t=%d %s" % [_mx_tick, line])
+	f.close()
+
+static func mx_stack(skip: int = 2, n: int = 5) -> String:
+	var st: Array = get_stack()
+	var out: Array = []
+	for i in range(skip, mini(st.size(), skip + n)):
+		out.append("%s:%d" % [String(st[i].get("function", "?")), int(st[i].get("line", 0))])
+	return " < ".join(out)
+
+static func mx_t(team: TeamData, label: String, args: String) -> void:
+	if team == null or team.team_id != _mx_ptid:
+		return
+	mx("CALL %s team=%d pop_before=%d anon_total=%d captives=%d named=%d leader=%d %s | %s" % [label, team.team_id, team.population, AnonTierSystem.total_pop(team), AnonTierSystem.total_captives(team), team.named_members.size(), team.leader_id, args, mx_stack(2, 5)])
+
 static func add(team: TeamData, res: String, amt: float, reason: String) -> void:
 	team.resources[res] = float(team.resources.get(res, 0.0)) + amt
 	_tally_food(team, res, amt)
diff --git a/scripts/simulation/sim_runner.gd b/scripts/simulation/sim_runner.gd
index 326cf2961..1913c0a13 100644
--- a/scripts/simulation/sim_runner.gd
+++ b/scripts/simulation/sim_runner.gd
@@ -109,7 +109,34 @@ func _init() -> void:
 # 放 production 而非床裡：放床裡的斷言依賴的正是它要抓的那份紀律（床沒清 player_id，多半也不會呼斷言）。
 static var _observer_guard_warned: bool = false
 
+
+var _mx_last: Dictionary = {}
+func _mx_pre(state: WorldState) -> void:
+	ResourceBank._mx_tick = state.world.current_tick
+	var ptid: int = state.get_player_team_id()
+	ResourceBank._mx_ptid = ptid
+	var pt: TeamData = state.teams.get(ptid)
+	var t2: TeamData = state.teams.get(2)
+	if t2 != null:
+		var f2: int = t2.faction_id
+		if _mx_last.has("f2") and int(_mx_last["f2"]) != f2:
+			ResourceBank.mx("F2DIFF faction_id %d->%d (snapshot; FACTION line with same tick = via set_team_faction, absence = bypass)" % [int(_mx_last["f2"]), f2])
+		_mx_last["f2"] = f2
+	if pt == null:
+		return
+	var snap: Dictionary = {"pop": pt.population, "leader": pt.leader_id, "named": pt.named_members.duplicate(), "anon": AnonTierSystem.total_pop(pt),
+		"wounded": AnonCohort.by_health(pt.anon_cohorts, "wounded"), "captives": AnonTierSystem.total_captives(pt), "minor": pt.minor_population,
+		"enc": state.encounter_active, "coh": pt.anon_cohorts.duplicate()}
+	if _mx_last.has("p"):
+		var o: Dictionary = _mx_last["p"]
+		if int(o["pop"]) != int(snap["pop"]) or o["leader"] != snap["leader"] or o["named"] != snap["named"] or int(o["anon"]) != int(snap["anon"]) or int(o["wounded"]) != int(snap["wounded"]) or int(o["captives"]) != int(snap["captives"]):
+			ResourceBank.mx("PDIFF team=%d pop %d->%d | leader %d->%d | named %s->%s | anon %d->%d (wounded %d->%d) | captives %d->%d | enc=%s | coh %s->%s" % [ptid, int(o["pop"]), int(snap["pop"]), int(o["leader"]), int(snap["leader"]), str(o["named"]), str(snap["named"]), int(o["anon"]), int(snap["anon"]), int(o["wounded"]), int(snap["wounded"]), int(o["captives"]), int(snap["captives"]), str(snap["enc"]), str(o["coh"]), str(snap["coh"])])
+	elif true:
+		ResourceBank.mx("PINIT " + str(snap))
+	_mx_last["p"] = snap
+
 func advance_tick(state: WorldState, player_pos: Vector2i) -> String:
+	_mx_pre(state)
 	if player_pos == Vector2i(-1, -1) and state.player_id != -1 and not _observer_guard_warned:
 		_observer_guard_warned = true
 		print("[ObserverGuard] 呼叫端宣稱無玩家（player_pos=(-1,-1)）但 state.player_id=%d ——" % state.player_id
