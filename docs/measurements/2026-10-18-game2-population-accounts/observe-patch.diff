 func _execute_betrayal(state: WorldState, self_team: TeamData,
 		ally_team: TeamData) -> void:
+	ResourceBank.mx("BETRAYAL exec self=%d (faction %d) ally=%d (faction %d) player_team=%d player_faction=%d" % [self_team.team_id, self_team.faction_id, ally_team.team_id, ally_team.faction_id, state.get_player_team_id(), (state.teams[state.get_player_team_id()] as TeamData).faction_id if state.teams.has(state.get_player_team_id()) else -9])
