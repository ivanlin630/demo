diff --git a/scripts/simulation/resource_bank.gd b/scripts/simulation/resource_bank.gd
index db5e56832..a521475a7 100644
--- a/scripts/simulation/resource_bank.gd
+++ b/scripts/simulation/resource_bank.gd
@@ -30,8 +30,26 @@ static func _tap_coin(res: String, delta: float, reason: String) -> void:
 	Probe.add_amount("coin.flow.by." + reason, absf(delta))
 	Probe.bump("coin.flow.n")
 
+# ★MX 量測專用（round5-replay worktree，不進 main）：純觀測、零 RNG。env GDS_MX_LOG 未設 ⇒ 不寫
+static var _mx_tick: int = 0
+static func mx(line: String) -> void:
+	var p: String = OS.get_environment("GDS_MX_LOG")
+	if p == "":
+		return
+	var f := FileAccess.open(p, FileAccess.READ_WRITE if FileAccess.file_exists(p) else FileAccess.WRITE)
+	if f == null:
+		return
+	f.seek_end()
+	f.store_line("t=%d %s" % [_mx_tick, line])
+	f.close()
+
+static func _mx_food(team: TeamData, delta: float, reason: String, kind: String) -> void:
+	if team != null and team.team_id == 15 and absf(delta) >= 1.0:
+		mx("FOOD %s team=%d delta=%.2f now=%.2f pop=%d reason=%s" % [kind, team.team_id, delta, float(team.resources.get("food", 0.0)), team.population, reason])
+
 static func add(team: TeamData, res: String, amt: float, reason: String) -> void:
 	team.resources[res] = float(team.resources.get(res, 0.0)) + amt
+	if res == "food": _mx_food(team, amt, reason, "add")
 	_tally_food(team, res, amt)
 	_tap_coin(res, amt, reason)
 	WorldState.record_driver(team, res, amt, reason, "resource")
@@ -40,6 +58,7 @@ static func remove(team: TeamData, res: String, amt: float, reason: String) -> f
 	var have: float = float(team.resources.get(res, 0.0))
 	var m: float = clampf(amt, 0.0, have)
 	team.resources[res] = have - m
+	if res == "food": _mx_food(team, -m, reason, "remove")
 	_tally_food(team, res, -m)
 	_tap_coin(res, -m, reason)
 	WorldState.record_driver(team, res, -m, reason, "resource")
@@ -50,6 +69,7 @@ static func set_amt(team: TeamData, res: String, amt: float, reason: String) ->
 	if Probe.enabled: Probe.bump("bank.call.team_set_amt")   # ★帳本守恆床的母體地板（純觀測、零 RNG）
 	var prev: float = float(team.resources.get(res, 0.0))
 	team.resources[res] = amt
+	if res == "food": _mx_food(team, amt - prev, reason, "set")
 	_tally_food(team, res, amt - prev)
 	# ★帳本記【變化量】（spec 2026-10-06 ledger-delta-must-sum-to-the-change §1①）——
 	#   舊版記 `amt`（新值）⇒ 一筆 set 看起來像「流入了整個存量」，前後兩筆 set 就是巨大的 ± 鏡像
diff --git a/scripts/simulation/sim_runner.gd b/scripts/simulation/sim_runner.gd
index 9d07427c7..010b22916 100644
--- a/scripts/simulation/sim_runner.gd
+++ b/scripts/simulation/sim_runner.gd
@@ -110,6 +110,7 @@ func _init() -> void:
 static var _observer_guard_warned: bool = false
 
 func advance_tick(state: WorldState, player_pos: Vector2i) -> String:
+	_mx_pre(state)
 	if player_pos == Vector2i(-1, -1) and state.player_id != -1 and not _observer_guard_warned:
 		_observer_guard_warned = true
 		print("[ObserverGuard] 呼叫端宣稱無玩家（player_pos=(-1,-1)）但 state.player_id=%d ——" % state.player_id
@@ -1144,3 +1145,45 @@ func _get_player_tile_pos(state: WorldState) -> Vector2i:
 		return Vector2i(-1, -1)
 	var t: TeamData = state.teams.get(p.team_id)
 	return t.tile_pos if t != null else Vector2i(-1, -1)
+
+
+# ★MX 量測（只觀測）：tick 起點與上一 tick 末態比對 —— 玩家隊糧撐分子／分母、任何隊人口一拍降 ≥2
+var _mx_prev_pop: Dictionary = {}
+var _mx_prev_ids: Dictionary = {}
+var _mx_last_food_hour: int = -1
+var _mx_sig11: String = ""
+func _mx_pre(state: WorldState) -> void:
+	ResourceBank._mx_tick = state.world.current_tick
+	var tick: int = state.world.current_tick
+	var pt: TeamData = state.teams.get(15)
+	if pt != null:
+		var hr: int = tick / WorldState.TICKS_PER_HOUR
+		if hr != _mx_last_food_hour:
+			_mx_last_food_hour = hr
+			ResourceBank.mx("SNAP15 food=%.2f pop=%d burn=%.3f days=%.2f named=%d minor=%d" % [float(pt.resources.get("food", 0.0)), pt.population,
+				float(pt.population) * ResourceSystem.FOOD_PER_PERSON_PER_DAY, PlayerApiMapper.food_days(pt), pt.named_members.size(), pt.minor_population])
+	for tid in state.teams:
+		var t: TeamData = state.teams[tid]
+		var old: int = int(_mx_prev_pop.get(tid, -1))
+		if old >= 0 and old - t.population >= 2:
+			var new_ids: Array = []
+			for k in state.teams:
+				if not _mx_prev_ids.has(k): new_ids.append(k)
+			ResourceBank.mx("POPDROP team=%d %d->%d named=%d minor=%d task=%s opt=%s tile=%s enc=%s new_teams=%s total_teams=%d" % [tid, old, t.population,
+				t.named_members.size(), t.minor_population, t.current_task, t.current_option, str(t.tile_pos), str(state.encounter_active), str(new_ids), state.teams.size()])
+	var t11: TeamData = state.teams.get(11)
+	if t11 != null:
+		var est: Dictionary = BeliefSystem.best_estimate(state, 15, 11)
+		var sig: String = "%d|%d|%d|%s|%s" % [t11.population, t11.named_members.size(), t11.minor_population, str(est.get("population_est", "-")), str(state.encounter_active)]
+		if sig != _mx_sig11:
+			_mx_sig11 = sig
+			ResourceBank.mx("T11 true_pop=%d named=%d leader=%d minor=%d anon=%d task=%s opt=%s tile=%s enc=%s | player_est_pop=%s teams=%d" % [t11.population, t11.named_members.size(), t11.leader_id, t11.minor_population,
+				t11.population - t11.named_members.size() - (1 if t11.leader_id != -1 else 0), t11.current_task, t11.current_option, str(t11.tile_pos), str(state.encounter_active), str(est.get("population_est", "-")), state.teams.size()])
+	elif _mx_sig11 != "gone":
+		_mx_sig11 = "gone"
+		ResourceBank.mx("T11 gone (team removed) teams=%d" % state.teams.size())
+	_mx_prev_pop.clear()
+	_mx_prev_ids.clear()
+	for tid in state.teams:
+		_mx_prev_pop[tid] = (state.teams[tid] as TeamData).population
+		_mx_prev_ids[tid] = true
